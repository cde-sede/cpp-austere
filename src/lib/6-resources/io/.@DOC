Buffered I/O over file descriptors, the process's standard streams, and an event loop
(`io::reactor`) driving many descriptors from one thread.

| Type | Buffer | Descriptor |
|---|---|---|
| `io::writer` | borrowed: memory the caller provides | borrowed |
| `io::reader` | borrowed | borrowed |
| `io::stream` | two borrowed buffers, a reader tied to a writer | borrowed: a socket, a terminal or a pipe pair |
| `io::buffered_writer<A>` | owned, from A, resizable | borrowed (`over`) or owned (`adopt`) |
| `io::buffered_reader<A>` | owned, from A, resizable | borrowed or owned |
| `io::out()`, `io::err()`, `io::in()` | per-thread stdout, stderr, process stdin | fds 1, 2 and 0 |

### Writers

An `io::writer` is a windowed writer (`io::is_windowed_writer`): `ca::print` and `format_to` format
straight into its buffer, which is written out according to its `buffering` policy: `full` when
it fills or on `flush()`, `line` also after every message holding a newline, `none` after every
message. Each call returns its own error, and the first error since the last check is kept,
sticky, so code that writes in many places checks once with `flush()`. When writing out fails,
the unwritten bytes stay pending: `flush()` retries them and `discard()` drops them; nothing is
retried behind the caller's back.

```c++
#include "ca/buffering.hpp"
#include "ca/file.hpp"
#include "ca/fs.hpp"
#include "ca/io.hpp"
#include "ca/print.hpp"
#include "ca/sv.hpp"
#include "ca/writer.hpp"

auto main(void) -> int {
	auto ends = ca::sys::pipe(ca::fs::cloexec_t::OPEN_VALUE);
	if (!ends)
		return 1;
	char buffer[64];
	ca::io::writer out{ends->write_end(), ca::io::buffering::full, buffer};
	if (!ca::print(out, "x={} ", 1) || !ca::print(out, "y={}\n", 2) || out.pending() != 8U)
		return 2;
	if (!out.flush() || out.pending() != 0U)
		return 3;

	char got[16];
	auto n = ca::sys::read(ends->read_end(), got);
	if (!n || ca::sv::str{got, *n} != ca::sv::str{"x=1 y=2\n"})
		return 4;

	auto direct = ca::io::writer::unbuffered(ends->write_end());
	if (!ca::print(direct, "now\n") || !ca::sys::read(ends->read_end(), got))
		return 5;
	return ca::sys::close(ends->read_end()) && ca::sys::close(ends->write_end()) ? 0 : 6;
}
```

### Readers

An `io::reader` is a buffered reader (`io::is_buffered_reader`): `fill()` and `consume(n)` let a
parser work inside the buffer, `read_until(delimiter)` returns the next delimited run in place,
and `read_line` / `read_to_end` (layer 5) copy out of it. A reader can be tied to a writer
(`tie`), whose pending output is written before each read that may block, so a prompt shows
before input is awaited; `io::in()` is tied to the calling thread's `io::out()` that way.

`io::stream` pairs a reader and a writer over one descriptor (a socket, a terminal) or two (a pipe
pair), the reader tied to the writer, so a request is sent before the reply is awaited.

```c++
#include "ca/buffering.hpp"
#include "ca/file.hpp"
#include "ca/format_to.hpp"
#include "ca/io.hpp"
#include "ca/stream.hpp"
#include "ca/sv.hpp"

auto main(void) -> int {
	auto requests = ca::sys::pipe(0);
	auto replies = ca::sys::pipe(0);
	if (!requests || !replies)
		return 1;
	char input[32];
	char output[32];
	ca::io::stream s{replies->read_end(), requests->write_end(), ca::io::buffering::full, input, output};
	if (!ca::format_to(s, "ping {}\n", 1) || s.pending() != 7U)
		return 2;
	if (!ca::sys::write(replies->write_end(), ca::sv::str{"pong 1\n"}))
		return 3;

	auto answer = s.read_until('\n');
	if (!answer || *answer != ca::sv::str{"pong 1\n"} || s.pending() != 0U)
		return 4;
	char sent[16];
	auto n = ca::sys::read(requests->read_end(), sent);
	if (!n || ca::sv::str{sent, *n} != ca::sv::str{"ping 1\n"})
		return 5;
	return ca::sys::close(requests->read_end()) && ca::sys::close(requests->write_end())
		&& ca::sys::close(replies->read_end()) && ca::sys::close(replies->write_end()) ? 0 : 6;
}
```

### Owned buffers

`buffered_writer<A>` and `buffered_reader<A>` own their buffer, from allocator A, and can own their
descriptor too: `over(fd, ...)` borrows it, `adopt(descriptor, ...)` takes an `fs::descriptor`
and closes it in `cleanup()`. Both are `make`, which picks by the argument (a borrowed fd or
`const fs::descriptor&`, a moved `fs::descriptor&&`), as `ca::make` and `ca::make_in` call it. `resize(capacity)` swaps the buffer (0 makes a writer unbuffered).
`writer()` and `reader()` give the inner object for code that takes an `io::writer&` or
`io::reader&`.

```c++
#include "ca/buffered_writer.hpp"
#include "ca/buffering.hpp"
#include "ca/descriptor.hpp"
#include "ca/file.hpp"
#include "ca/fs.hpp"
#include "ca/print.hpp"
#include "ca/utility.hpp"

auto main(void) -> int {
	auto file = ca::fs::descriptor::open("log.tmp", ca::fs::writable | ca::fs::create | ca::fs::truncate, 0644U);
	if (!file)
		return 1;
	auto log = ca::io::buffered_writer<>::adopt(ca::move(*file), ca::io::buffering::line, 4096U);
	if (!log || !log->owns_descriptor())
		return 2;
	for (int i = 0; i < 3; ++i)
		if (!ca::print(log->writer(), "event {}\n", i))
			return 3;
	return log->cleanup() && ca::sys::unlink("log.tmp") ? 0 : 4;
}
```

### Standard streams

`io::out()` is this thread's standard output: a 4 KiB buffer, line policy on a terminal and full
otherwise, opened on first use, flushed when the thread exits and, for the thread that calls
`exit` (returning from `main` included), at exit; `exit_immediately` and crashes drop it. Being per
thread, it needs no lock, and each message reaches fd 1 whole. `io::err()` is unbuffered: each
message is one write as it happens. `io::in()` is the process's standard input, one per process,
so read it from one thread at a time.

### Reactor

`io::reactor` is an event loop over epoll, owned by the thread that runs it. It calls handlers
the caller owns, each a class deriving from a base templated on itself:

| Base | Registered by | Calls |
|---|---|---|
| `io::watcher<Self>` | `watch(w, fd, interest)`, `change`, `unwatch` | `on_readable(reactor&)`, `on_writable(reactor&)`, optionally `on_hangup(reactor&)` |
| `io::timer<Self>` | `schedule_at(t, deadline_ns)`, `schedule_after(t, delay_ns)`, `cancel` | `on_timer(reactor&)`, once per scheduling |
| `io::task<Self>` | `post(t)`, from any thread | `on_posted(reactor&)`, on the reactor's thread |

The reactor allocates nothing: the handlers hold their links (24 to 56 bytes) and the reactor
their addresses, so a handler stays put while watched, scheduled or posted. A handler may do
anything to the reactor, itself included: unwatch itself and be destroyed, reschedule itself
(a periodic timer), watch new descriptors (an accepted connection). Unwatching drops the
handler's pending events of the current round too, so a closed connection is never called again.

`interest` bits are `readable`, `writable` and `none`, level-triggered: a handler is called while
its descriptor stays ready, so one read per call is enough. A buffered reader may hold more than
the descriptor shows, though, so a handler parsing with `read_until` loops until `try_again`.
`interest::edge` switches a watch to edge triggering (called on changes only: drain until
`try_again`). The usual write path stays readable-only: write, `write_pending()`; on `try_again`,
`clear_error()` and `change` to `readable | writable`; `on_writable` writes the rest and drops
writable again. Errors and hangups go to `on_hangup` when Self has one, otherwise to its other
handlers as readiness (the next read returns 0 or the error).

`run()` loops until `stop()` or until nothing is left: no watch, no timer, no posted task. A
round is one epoll_wait (its timeout the nearest timer deadline, in nanoseconds), the ready
handlers, the due timers, then the posted tasks. One reactor per thread scales out: each thread
runs its own, with listeners bound through `socket_option::reuse_port`, or one acceptor handing
descriptors to the others in posted tasks. `post`, `wake` and `stop` are the only members other
threads may call; `post` is one CAS and, at most once per round, an eventfd write.

```c++
#include "ca/buffering.hpp"
#include "ca/error.hpp"
#include "ca/file.hpp"
#include "ca/format_to.hpp"
#include "ca/fs.hpp"
#include "ca/interest.hpp"
#include "ca/net.hpp"
#include "ca/optional.hpp"
#include "ca/reactor.hpp"
#include "ca/stream.hpp"
#include "ca/sv.hpp"
#include "ca/timer.hpp"
#include "ca/watcher.hpp"

struct watchdog final : ca::io::timer<watchdog> {

	bool fired = false;

	auto on_timer(ca::io::reactor& r) noexcept -> void {
		fired = true;
		r.stop();
	}

};

struct connection final : ca::io::watcher<connection> {

	int fd;
	char input[256];
	char output[256];
	ca::io::stream stream;
	watchdog* dog;

	connection(const int socket, watchdog* const d) noexcept
	: fd{socket}, input{}, output{}, stream{socket, ca::io::buffering::full, input, output}, dog{d} {
	}

	auto finish(ca::io::reactor& r) noexcept -> void {
		(void)stream.flush();
		(void)r.unwatch(*this);
		(void)ca::sys::close(fd);
		r.cancel(*dog);
	}

	auto on_readable(ca::io::reactor& r) noexcept -> void {
		for (;;) {
			auto line = stream.read_until('\n');
			if (!line) {
				if (line.error() != ca::errc::try_again)
					finish(r);
				return;
			}
			if (line->size() == 0U || !ca::format_to(stream, "{}", *line) || !stream.write_pending()) {
				finish(r);
				return;
			}
		}
	}

};

struct listener final : ca::io::watcher<listener> {

	int fd = -1;
	watchdog* dog = nullptr;
	ca::optional<connection>* slot = nullptr;

	auto on_readable(ca::io::reactor& r) noexcept -> void {
		auto peer = ca::sys::accept(fd, ca::fs::cloexec_t::OPEN_VALUE | ca::fs::nonblock_t::OPEN_VALUE);
		if (!peer)
			return;
		connection& c = *slot->emplace(*peer, dog);
		if (!r.watch(c, *peer, ca::io::interest::readable))
			r.stop();
		(void)r.unwatch(*this);
	}

};

auto main(void) -> int {
	auto made = ca::io::reactor::make();
	if (!made)
		return 1;
	ca::io::reactor& r = *made;
	const int cloexec = ca::fs::cloexec_t::OPEN_VALUE;
	auto server = ca::sys::tcp_listen(ca::sys::ipv4_endpoint::loopback(0U), -1, cloexec | ca::fs::nonblock_t::OPEN_VALUE);
	auto address = server ? ca::sys::local_endpoint(*server) : server.propagate();
	if (!server || !address)
		return 2;
	auto client = ca::sys::tcp_connect(*address, cloexec);
	if (!client || !ca::sys::write_all(*client, ca::sv::str{"hello\n"}) || !ca::sys::shutdown(*client, ca::sys::shutdown_side::write))
		return 3;

	watchdog dog{};
	ca::optional<connection> slot{};
	listener l{};
	l.fd = *server;
	l.dog = &dog;
	l.slot = &slot;
	if (!r.watch(l, *server, ca::io::interest::readable))
		return 4;
	r.schedule_after(dog, 1000000000);
	if (!r.run() || dog.fired)
		return 5;

	char reply[16];
	auto n = ca::sys::read(*client, reply);
	if (!n || ca::sv::str{reply, *n} != ca::sv::str{"hello\n"})
		return 6;
	return ca::sys::close(*client) && ca::sys::close(*server) && r.cleanup() ? 0 : 7;
}
```
